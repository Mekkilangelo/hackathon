generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MichelinType {
  ETOILE
  BIB_GOURMAND
  ETOILE_VERTE
  SELECTION
}

enum ChatRole {
  USER
  SEBASTIAN
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  passwordHash String?       @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  profile      UserProfile?
  chatSessions ChatSession[]

  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diet      String[]
  budget    Int
  vibes     String[]
  occasions String[]
  cuisines  String[]
  city      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model Restaurant {
  id            String       @id @default(uuid())
  name          String
  cuisine       String
  priceRange    Int          @map("price_range")
  michelinType  MichelinType @map("michelin_type")
  michelinStars Int?         @map("michelin_stars")
  greenStar     Boolean      @default(false) @map("green_star")
  address       String
  location      String
  country       String?
  zone          String?
  latitude      Float?
  longitude     Float?
  description   String
  ambiance      String?
  imageUrl      String?      @map("image_url")
  gallery       String[]
  hours         Json?
  tags          String[]
  websiteUrl    String?      @map("website_url")
  michelinUrl   String?      @map("michelin_url")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([cuisine])
  @@index([location])
  @@index([country])
  @@index([michelinType])
  @@index([priceRange])
  @@map("restaurants")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}
